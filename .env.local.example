# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys) — used to send booking/review emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Salonly <notifications@yourdomain.com>"

# Telegram bot (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public site URL, used to build booking/telegram deep links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
